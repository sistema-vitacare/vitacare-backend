{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "roots": [
    "<rootDir>/tests"
  ],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/tests/e2eGlobalSetup.cjs",
  "maxWorkers": 1,
  "reporters": [
    "default",
    "<rootDir>/tests/skippedTestsReporter.cjs"
  ]
}
