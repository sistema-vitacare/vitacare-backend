# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
NODE_ENV=production
# Porta interna do container. O mapeamento para o host usa HOST_PORT.
PORT=3000
API_PREFIX=api
API_VERSION=1
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Docker (lidas apenas pelo compose, nao pela aplicacao)
# ---------------------------------------------------------------------------
# Porta publicada no host.
HOST_PORT=3000
# Rede docker onde PostgreSQL e Redis ja estao acessiveis.
DOCKER_NETWORK=vitacare-net

# ---------------------------------------------------------------------------
# Documentacao
# ---------------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ---------------------------------------------------------------------------
# Seguranca
# ---------------------------------------------------------------------------
# Origens do frontend, separadas por virgula. Vazio em producao = CORS desligado.
CORS_ORIGINS=https://app.example.com
CORS_CREDENTIALS=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Autenticacao e SMTP opcional
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
PASSWORD_RESET_URL=https://app.example.com/redefinir-senha
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# PostgreSQL externo
# ---------------------------------------------------------------------------
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_USERNAME=vitacare
DB_PASSWORD=change-me
DB_DATABASE=vitacare
DB_SCHEMA=public
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
DB_MIGRATIONS_TABLE=migrations

# ---------------------------------------------------------------------------
# Redis externo (cache e filas/workers)
# ---------------------------------------------------------------------------
REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_KEY_PREFIX=vitacare:
QUEUE_PREFIX=vitacare
