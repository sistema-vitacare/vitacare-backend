# Modelo das variáveis de PRODUÇÃO (stack `vitacare` do Portainer).
#
# NÃO é lido pela aplicação nem entra na imagem. Uso:
#   1. cp .env.production.example .env.production   (ignorado pelo git)
#   2. preencha os valores
#   3. Portainer → Stacks → vitacare → Environment variables → Advanced mode
#      → cole o conteúdo
# O docker-compose.prod.yml interpola cada ${VAR} nos containers.
# Sem aspas e sem comentário na mesma linha: o Portainer guarda as aspas no valor.
# Só as marcadas OBRIGATÓRIA não têm padrão; as demais podem ser omitidas.

# OBRIGATÓRIA. Senha do usuário PRÓPRIO `vitacare` no Postgres da stack infra
# (docs/deploy-vps.md, passo 1). Nunca a do superusuário.
DB_PASSWORD=

# OBRIGATÓRIA. A MESMA REDIS_PASSWORD da stack infra.
REDIS_PASSWORD=

# Etapa atual (sem domínio): expõe a porta 1040 na internet.
# Apague quando o domínio + Nginx Proxy Manager existirem.
APP_BIND=0.0.0.0

# Origens do frontend, separadas por vírgula. Vazio = CORS desligado.
CORS_ORIGINS=

# Escala: réplicas da API e teto de cada uma (docs/deploy-vps.md, Dimensionamento).
# API_REPLICAS=2
# API_MEM_LIMIT=512m
# API_HEAP_MB=384
# API_CPUS=0.5
# DB_POOL_SIZE=5

# Opcionais (padrões do docker-compose.prod.yml)
# DB_HOST=postgresql
# DB_DATABASE=vitacare
# DB_USERNAME=vitacare
# REDIS_HOST=redis
# LOG_LEVEL=info
# SWAGGER_ENABLED=true
# RUN_MIGRATIONS=true
# INFRA_NETWORK=infra
# PROXY_NETWORK=proxy
# Rollback: fixa uma versão anterior; apague para voltar à :latest.
# APP_IMAGE=ghcr.io/sistema-vitacare/vitacare-backend:sha-<commit>
# GATEWAY_IMAGE=ghcr.io/sistema-vitacare/vitacare-backend-gateway:sha-<commit>
