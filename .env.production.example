# Modelo das variáveis de PRODUÇÃO (stack `vitacare` do Portainer).
#
# NÃO é lido pela aplicação nem entra na imagem. Uso:
#   1. cp .env.production.example .env.production   (ignorado pelo git)
#   2. preencha os valores
#   3. Portainer → Stacks → vitacare → Environment variables → Advanced mode
#      → cole o conteúdo
# O docker-compose.prod.yml interpola cada ${VAR} nos containers.
# Sem aspas e sem comentário na mesma linha: o Portainer guarda as aspas no valor.
# Só as marcadas OBRIGATÓRIA não têm padrão; as demais podem ser omitidas.

# OBRIGATÓRIA. Senha do usuário PRÓPRIO `vitacare` no Postgres da stack infra
# (docs/deploy-vps.md, passo 1). Nunca a do superusuário.
DB_PASSWORD=

# OBRIGATÓRIA. A MESMA REDIS_PASSWORD da stack infra.
REDIS_PASSWORD=

# Sem APP_BIND: a porta 1050 fica presa em 127.0.0.1 e o acesso público é
# https://api.vitacare.bizys.com.br, pelo Nginx Proxy Manager (OPS-01).

# Origens do frontend, separadas por vírgula. Vazio = CORS desligado.
CORS_ORIGINS=https://vitacare.bizys.com.br

# Link do app no push e no e-mail.
NOTIFICATION_APP_URL=https://vitacare.bizys.com.br

# E-mail (Hostinger). SMTP_FROM só com o endereço: com nome a API não sobe.
# SMTP_ENABLED=true
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@vitacare.bizys.com.br
# SMTP_PASSWORD=<senha da caixa>
# SMTP_FROM=no-reply@vitacare.bizys.com.br
# PASSWORD_RESET_URL=https://vitacare.bizys.com.br/redefinir-senha
# INVITATION_ACCEPT_URL=https://vitacare.bizys.com.br/aceitar-convite

# Push do navegador: gerar o par UMA vez (`npx web-push generate-vapid-keys`);
# trocar depois invalida as inscrições.
# WEB_PUSH_ENABLED=true
# WEB_PUSH_PUBLIC_KEY=<chave publica>
# WEB_PUSH_PRIVATE_KEY=<chave privada>
# WEB_PUSH_SUBJECT=mailto:<contato>

# Heartbeat dos workers: URL do monitor Push do Uptime Kuma (intervalo 600 s),
# pelo nome do container na rede infra. Vazia = sem heartbeat (não recomendado).
# Descomente com o token real: com o <token> literal a API não sobe.
# UPTIME_KUMA_PUSH_URL=http://uptime-kuma:3001/api/push/<token>

# Recursos do container (docs/deploy-vps.md, Dimensionamento).
# API_MEM_LIMIT=512m
# API_HEAP_MB=384
# API_CPUS=1.0
# DB_POOL_SIZE=10

# Opcionais (padrões do docker-compose.prod.yml)
# DB_HOST=postgresql
# DB_DATABASE=vitacare
# DB_USERNAME=vitacare
# REDIS_HOST=redis
# LOG_LEVEL=info
# SWAGGER_ENABLED=true
# RUN_MIGRATIONS=true
# INFRA_NETWORK=infra
# PROXY_NETWORK=proxy
# Rollback: fixa uma versão anterior; apague para voltar à :latest.
# APP_IMAGE=ghcr.io/sistema-vitacare/vitacare-backend:sha-<commit>
